# Copy this file to .env.local and fill in real values.
# Nothing in this project requires an API key to run or deploy —
# these are only needed if you wire up a real AI or GitHub API call
# to replace the static demo data in the AI + Odoo Playground / GitHub section.

# Optional: used only if you add a server-side route that calls an LLM API.
# Never prefix this with NEXT_PUBLIC_ — that would expose it to the browser.
ANTHROPIC_API_KEY=

# Optional: raises GitHub's API rate limit if you wire up live repo data.
GITHUB_TOKEN=
